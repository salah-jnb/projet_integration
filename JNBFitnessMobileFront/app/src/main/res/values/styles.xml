<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Theme principal de l'application -->
    <style name="Theme.JnbFitness" parent="Theme.App.Modern.NoActionBar" />

    <!-- TYPOGRAPHY -->
    <style name="TextAppearance.App.H1" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.App.H2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.H3" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- BUTTONS -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/orange_strong</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="elevation">4dp</item>
    </style>
    
    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/orange_strong</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <style name="Widget.App.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/orange_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/orange_strong</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <style name="Widget.App.Button.Gradient" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/gradient_brown_orange</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <!-- CARDS -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.App.Card.Gradient" parent="Widget.App.Card">
        <item name="android:background">@drawable/gradient_black_brown</item>
        <item name="cardBackgroundColor">@null</item>
    </style>

    <!-- TEXT FIELDS -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/orange_strong</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/orange_strong</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="boxBackgroundColor">@color/input_background</item>
    </style>

    <style name="Widget.App.TextInputEditText" parent="ThemeOverlay.Material3.TextInputEditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- LEGACY STYLES (MAPPED TO NEW SYSTEM) -->
    <style name="CoachCard" parent="Widget.App.Card">
        <item name="cardBackgroundColor">@color/surface_variant</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="CoachToolbar">
        <item name="android:background">@color/surface_variant</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="CoachButton" parent="Widget.App.Button.Primary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="CoachButtonSmall" parent="CoachButton">
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="CoachButtonLarge" parent="CoachButton">
        <item name="android:layout_height">42dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="CoachButtonSmallDanger" parent="CoachButtonSmall">
        <item name="backgroundTint">@color/error</item>
    </style>

    <style name="CoachButtonSmallSuccess" parent="CoachButtonSmall">
        <item name="backgroundTint">@color/success</item>
    </style>

    <style name="CoachButtonOutlined" parent="Widget.App.Button.Outline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="CoachButtonOutlinedPrimary" parent="CoachButtonOutlined">
        <item name="android:textColor">@color/orange_strong</item>
        <item name="strokeColor">@color/orange_strong</item>
    </style>

    <style name="CoachChipButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:backgroundTint">@color/surface_variant</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="CoachChipButtonSelected" parent="CoachChipButton">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/orange_strong</item>
    </style>

    <style name="CoachProgressBarHorizontal">
        <item name="android:layout_height">4dp</item>
        <item name="android:indeterminateTint">@color/orange_strong</item>
        <item name="android:progressBackgroundTint">@color/progress_bar_track</item>
    </style>

    <style name="AppTitle" parent="TextAppearance.App.H2" />
    <style name="AppSubtitle" parent="TextAppearance.App.H3" />
    <style name="AppBody" parent="TextAppearance.App.Body" />
    <style name="AppCaption" parent="TextAppearance.App.Caption" />

    <style name="TextArticleTitle" parent="TextAppearance.App.H3">
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="CoachNameText" parent="TextAppearance.App.H3" />
    <style name="CoachStatsText" parent="TextAppearance.App.H3">
        <item name="android:textSize">18sp</item>
    </style>

    <!-- BADGES -->
    <style name="BadgeBase">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="ArticleStatusPublished" parent="BadgeBase">
        <item name="android:background">@drawable/badge_published</item>
    </style>

    <style name="ArticleStatusDraft" parent="BadgeBase">
        <item name="android:background">@drawable/badge_draft</item>
    </style>

    <style name="NotificationTypeReservation" parent="BadgeBase">
        <item name="android:background">@drawable/badge_reservation</item>
    </style>

    <style name="NotificationTypeMessage" parent="BadgeBase">
        <item name="android:background">@drawable/badge_message</item>
    </style>

    <style name="ProductStatusActive" parent="BadgeBase">
        <item name="android:background">@drawable/badge_active</item>
    </style>

    <style name="ProductStatusInactive" parent="BadgeBase">
        <item name="android:background">@drawable/badge_inactive</item>
    </style>

    <style name="BookingStatusConfirmed" parent="BadgeBase">
        <item name="android:background">@drawable/badge_confirmed</item>
    </style>

    <style name="BookingStatusPending" parent="BadgeBase">
        <item name="android:background">@drawable/badge_pending</item>
    </style>

    <style name="BookingStatusCompleted" parent="BadgeBase">
        <item name="android:background">@drawable/badge_completed</item>
    </style>

    <style name="BookingStatusCancelled" parent="BadgeBase">
        <item name="android:background">@drawable/badge_cancelled</item>
    </style>

    <style name="SessionStatusActive" parent="BadgeBase">
        <item name="android:background">@drawable/badge_active</item>
    </style>

    <style name="SessionStatusCompleted" parent="BadgeBase">
        <item name="android:background">@drawable/badge_completed</item>
    </style>

    <style name="SessionStatusCancelled" parent="BadgeBase">
        <item name="android:background">@drawable/badge_cancelled</item>
    </style>

    <style name="NotificationIndicator">
        <item name="android:background">@drawable/notification_indicator</item>
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginRight">12dp</item>
    </style>

    <style name="ShapeAppearanceOverlay_Jnb_Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
