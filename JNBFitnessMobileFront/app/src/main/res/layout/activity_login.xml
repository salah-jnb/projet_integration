<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <!-- Logo -->
    <TextView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JNB FITNESS"
        style="@style/TextAppearance.App.H2"
        android:textColor="@color/orange_strong"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp" />

    <!-- Carte de connexion -->
    <androidx.cardview.widget.CardView
        android:id="@+id/login_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        style="@style/Widget.App.Card"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Titre -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connexion"
                style="@style/TextAppearance.App.H2"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Sous-titre -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Content de vous revoir !"
                style="@style/TextAppearance.App.Body"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- Champ Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.App.TextInputLayout"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/orange_strong">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    style="@style/Widget.App.TextInputEditText" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Champ Mot de passe -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.App.TextInputLayout"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/orange_strong">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mot de passe"
                    android:inputType="textPassword"
                    style="@style/Widget.App.TextInputEditText" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mot de passe oublié -->
            <TextView
                android:id="@+id/forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mot de passe oublié ?"
                style="@style/TextAppearance.App.Caption"
                android:textColor="@color/orange_strong"
                android:textStyle="bold"
                android:layout_gravity="end"
                android:layout_marginBottom="24dp"
                android:padding="4dp" />

            <!-- Bouton de connexion -->
            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Se connecter"
                style="@style/Widget.App.Button.Gradient"
                android:layout_marginBottom="24dp" />

            <!-- Séparateur -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_centerVertical="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ou"
                    style="@style/TextAppearance.App.Caption"
                    android:background="@color/card_background"
                    android:paddingHorizontal="16dp"
                    android:layout_centerInParent="true" />

            </RelativeLayout>

            <!-- Bouton inscription -->
            <Button
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Créer un compte"
                style="@style/Widget.App.Button.Outline" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ProgressBar moderne -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/orange_strong"
        app:trackColor="@color/surface_variant"
        app:layout_constraintTop_toBottomOf="@id/login_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
