<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Optionnel : Pour télécharger/sauvegarder des images -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="28" 
        tools:ignore="ScopedStorage" />
    
    <!-- Optionnel : Pour l'appareil photo -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Modern.NoActionBar"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Activity Landing (écran de démarrage) -->
        <activity
            android:name=".LandingActivity"
            android:exported="true"
            android:theme="@style/Theme.JNBFitnessMobileFront.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity d'authentification -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.App.Modern.NoActionBar" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.App.Modern.NoActionBar" />

        <!-- Activity principale -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.App.Modern.NoActionBar" />

        <!-- Activities Admin -->
        <activity android:name=".admin.AdminActivity" android:exported="false" />
        <activity android:name=".admin.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".admin.AdminUsersActivity" android:exported="false" />
        <activity android:name=".admin.AdminAbonnementsActivity" android:exported="false" />
        <activity android:name=".admin.AdminCoursActivity" android:exported="false" />
        <activity android:name=".admin.AdminArticlesActivity" android:exported="false" />
        <activity android:name=".admin.AdminProduitsActivity" android:exported="false" />
        <activity android:name=".admin.AdminPaiementsActivity" android:exported="false" />
        <activity android:name=".admin.AdminCartesActivity" android:exported="false" />

        <!-- Activities Coach -->
        <activity android:name=".coach.CoachActivity" android:exported="false" />
        <activity android:name=".coach.CoachDashboardActivity" android:exported="false" />
        <activity android:name=".coach.CoachReservationsActivity" android:exported="false" />
        <activity android:name=".coach.CoachDisponibilitesActivity" android:exported="false" />
        <activity android:name=".coach.CoachCollectiveClassesActivity" android:exported="false" />
        <activity android:name=".coach.CoachArticlesActivity" android:exported="false" />
        <activity android:name=".coach.CoachProductsActivity" android:exported="false" />
        <activity android:name=".coach.CoachNotificationsActivity" android:exported="false" />
        <activity android:name=".coach.CoachProfileActivity" android:exported="false" />

        <!-- Activities Client -->
        <activity android:name=".client.ClientActivity" android:exported="false" />
        <activity android:name=".client.ClientDashboardActivity" android:exported="false" />
        <activity android:name=".client.ClientProfileActivity" android:exported="false" />
        <activity android:name=".client.ClientAbonnementsActivity" android:exported="false" />
        <activity android:name=".client.ClientCartesActivity" android:exported="false" />
        <activity android:name=".client.ClientCoachingActivity" android:exported="false" />
        <activity android:name=".client.ClientCollectiveClassesActivity" android:exported="false" />
        <activity android:name=".client.ClientReferralsActivity" android:exported="false" />
        <activity android:name=".client.ClientNotificationsActivity" android:exported="false" />
        <activity android:name=".client.ClientProductsActivity" android:exported="false" />
        <activity android:name=".client.ClientArticlesActivity" android:exported="false" />

        <!-- Service optionnel pour les notifications -->
        <!-- <service android:name=".service.NotificationService" android:exported="false" /> -->

    </application>

</manifest>
