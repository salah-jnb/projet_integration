<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/gradient_black_brown"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_profile_placeholder"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:layout_marginRight="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/coach_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jean-Michel Coach"
                style="@style/TextAppearance.App.H3"
                android:textColor="@color/white"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/coach_specialty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fitness &amp; Nutrition"
                style="@style/TextAppearance.App.Caption"
                android:textColor="@color/orange_strong"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"/>

            <!-- Rating -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/orange_strong"
                    android:layout_marginRight="4dp"/>

                <TextView
                    android:id="@+id/coach_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.8"
                    android:textColor="@color/orange_strong"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginRight="4dp"/>

                <TextView
                    android:id="@+id/coach_reviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(128 avis)"
                    style="@style/TextAppearance.App.Caption"/>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_verified"
            app:tint="@color/orange_strong"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_variant"
        android:layout_marginBottom="16dp"/>

    <!-- Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/total_clients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="156"
                style="@style/TextAppearance.App.H3"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clients"
                style="@style/TextAppearance.App.Caption"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/surface_variant"
            android:layout_gravity="center"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/total_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="892"
                style="@style/TextAppearance.App.H3"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Séances"
                style="@style/TextAppearance.App.Caption"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/surface_variant"
            android:layout_gravity="center"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/response_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="98%"
                style="@style/TextAppearance.App.H3"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Réponse"
                style="@style/TextAppearance.App.Caption"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
