<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/Widget.App.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Image avec ratio fixe -->
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Image de l'article"
            android:layout_marginBottom="12dp"/>

        <!-- Header avec titre et badge de statut -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TextAppearance.App.H3"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/statut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brouillon"
                style="@style/BadgeBase"
                android:background="@drawable/badge_draft"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginLeft="12dp"/>

        </LinearLayout>

        <!-- Contenu de l'article -->
        <TextView
            android:id="@+id/contenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.App.Body"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="8dp"/>

        <!-- Dates et métadonnées -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_schedule"
                app:tint="@color/text_secondary"
                android:contentDescription="@null"
                android:layout_marginRight="6dp"/>

            <TextView
                android:id="@+id/dates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.App.Caption"/>

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/surface_variant"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary"
                android:contentDescription="@null"
                android:layout_marginRight="6dp"/>

            <TextView
                android:id="@+id/views"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 vues"
                style="@style/TextAppearance.App.Caption"/>

        </LinearLayout>

        <!-- Actions avec boutons standards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publier"
                style="@style/Widget.App.Button.Primary"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modifier"
                style="@style/Widget.App.Button.Outline"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supprimer"
                style="@style/Widget.App.Button.Outline"
                app:strokeColor="@color/error"
                android:textColor="@color/error"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
